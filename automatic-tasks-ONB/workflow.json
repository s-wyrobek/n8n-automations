    {
      "parameters": {
        "jsCode": "const html = $input.item.json.textAsHtml || $input.item.json.text || '';\n\n// 1. TEXT CLEANUP\nconst text = html\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// 2. GUILLOTINE FUNCTION — extracts value between two phrases\nfunction getVal(startPhrase, endPhrase) {\n  const lowerText = text.toLowerCase();\n  const startIndex = lowerText.indexOf(startPhrase.toLowerCase());\n  if (startIndex === -1) return '';\n  const valStart = startIndex + startPhrase.length;\n  let endIndex = endPhrase\n    ? lowerText.indexOf(endPhrase.toLowerCase(), valStart)\n    : -1;\n  let result = (endIndex === -1)\n    ? text.substring(valStart, valStart + 100)\n    : text.substring(valStart, endIndex);\n  return result.replace(/^[:\\s\\-\\.]+|[:\\s\\-\\.]+$/g, '').trim();\n}\n\n// 3. FIELD EXTRACTION\n// Adjust label names to match your HR email table format.\n// Add or remove fields as needed.\nconst fullName  = getVal('FULL NAME',  'START DATE');\nconst rawDate   = getVal('START DATE', 'POSITION');\nconst position  = getVal('POSITION',   'TEAM');\nconst team      = getVal('TEAM',       'LOCATION');\nconst location  = getVal('LOCATION',   '');\n// Add your custom fields here:\n// const myField = getVal('MY LABEL', 'NEXT LABEL');\n\n// 4. DATE NORMALIZATION (DD.MM.YYYY / DD/MM/YYYY / DD-MM-YYYY → YYYY-MM-DD)\nlet formattedDate = null;\nconst dateMatch = rawDate.match(/(\\d{1,2})[-./](\\d{1,2})[-./](\\d{4})/);\nif (dateMatch) {\n  formattedDate = `${dateMatch[3]}-${dateMatch[2].padStart(2,'0')}-${dateMatch[1].padStart(2,'0')}`;\n}\n\nreturn {\n  fullName:      fullName,\n  startDate:     rawDate,\n  startDateJira: formattedDate,\n  position:      position,\n  team:          team,\n  location:      location\n  // Add your custom fields here\n};"
      },

      "parameters": {
        "jsCode": "const html = $input.item.json.textAsHtml || '';\n\n// 1. TEXT CLEANUP\nconst text = html\n  .replace(/<br\\s*\\/?>/gi, ' ')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// 2. FIND START OF TABLE\nconst startOfTable = text.indexOf('FULL NAME');\nconst cleanText = startOfTable > -1 ? text.substring(startOfTable) : text;\n\n// 3. GUILLOTINE FUNCTION — extracts value between two phrases\nfunction getVal(startPhrase, endPhrases) {\n  const startIndex = cleanText.indexOf(startPhrase);\n  if (startIndex === -1) return '';\n  const valStart = startIndex + startPhrase.length;\n  let bestEndIndex = cleanText.length;\n  const ends = Array.isArray(endPhrases) ? endPhrases : [endPhrases];\n  ends.forEach(phrase => {\n    if (!phrase) return;\n    const idx = cleanText.indexOf(phrase, valStart);\n    if (idx > -1 && idx < bestEndIndex) bestEndIndex = idx;\n  });\n  return cleanText.substring(valStart, bestEndIndex)\n    .replace(/^[:\\s|]+|[:\\s|]+$/g, '').trim();\n}\n\n// 4. FIELD EXTRACTION\n// Adjust label names to match your HR email table format.\n// Add or remove fields as needed.\nconst fullName       = getVal('FULL NAME',        'LAST WORKING DAY');\nconst rawLastDay     = getVal('LAST WORKING DAY', 'CONTRACT END DATE');\nconst rawContractEnd = getVal('CONTRACT END DATE',['TEAM', 'PROJECT']);\nconst team           = getVal('TEAM',             'LOCATION');\nconst location       = getVal('LOCATION',         '');\n// Add your custom fields here:\n// const myField = getVal('MY LABEL', 'NEXT LABEL');\n\n// 5. DATE NORMALIZATION (DD.MM.YYYY / DD/MM/YYYY / DD-MM-YYYY → YYYY-MM-DD)\nfunction normalizeDate(raw) {\n  const match = raw.match(/(\\d{1,2})[-./](\\d{1,2})[-./](\\d{4})/);\n  if (!match) return null;\n  return `${match[3]}-${match[2].padStart(2,'0')}-${match[1].padStart(2,'0')}`;\n}\n\nreturn {\n  fullName:         fullName,\n  lastWorkingDay:   rawLastDay,\n  lastWorkingDayJira: normalizeDate(rawLastDay) || new Date().toISOString().split('T')[0],\n  contractEndDate:  rawContractEnd,\n  team:             team,\n  location:         location\n  // Add your custom fields here\n};"
      },
